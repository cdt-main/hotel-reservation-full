        + getAllPromos(): ResponseEntity<List<PromoCode>>
        + createPromo(promoCode: PromoCode): ResponseEntity<PromoCode>
        + deletePromo(id: Long): ResponseEntity<Map<String, Object>>
    }

    class MainController {
        + forwardToIndex(): String
    }
}

