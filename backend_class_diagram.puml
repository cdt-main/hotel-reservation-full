        + deleteById(id: Long): void
    }

    interface RoomRepository <<interface>> {
        + findBySlug(slug: String): Optional<Room>
        + findByType(type: String): List<Room>
        + findByFeaturedTrue(): List<Room>
        + searchRooms(type: String, minPrice: Double, maxPrice: Double, guests: Integer): List<Room>
        + count(): long
        + findAll(): List<Room>
        + findById(id: Long): Optional<Room>
        + save(room: Room): Room
        + deleteById(id: Long): void
    }

    interface UserRepository <<interface>> {
        + findByEmail(email: String): Optional<User>
        + existsByEmail(email: String): boolean
        + findAll(): List<User>
        + findById(id: Long): Optional<User>
        + save(user: User): User
        + deleteById(id: Long): void
    }

    interface ReviewRepository <<interface>> {
        + findByStatusOrderByCreatedAtDesc(status: String): List<Review>
        + findAllByOrderByCreatedAtDesc(): List<Review>
        + findAll(): List<Review>
        + findById(id: Long): Optional<Review>
        + save(review: Review): Review
        + deleteById(id: Long): void
    }

    interface PromoCodeRepository <<interface>> {
        + findByCodeIgnoreCaseAndIsActiveTrue(code: String): Optional<PromoCode>
        + findAll(): List<PromoCode>
        + findById(id: Long): Optional<PromoCode>
        + save(promoCode: PromoCode): PromoCode
        + deleteById(id: Long): void
    }
}

