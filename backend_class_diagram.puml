' ==============================================================================
' UML RELATIONSHIPS
' ==============================================================================

' --- 1. INHERITANCE / GENERALIZATION (<|--) ---
BaseEntity <|-- Room
BaseEntity <|-- Booking
BaseEntity <|-- User
BaseEntity <|-- Review
BaseEntity <|-- PromoCode

BaseService <|-- RoomService
BaseService <|-- BookingService
BaseService <|-- UserService
BaseService <|-- ReviewService
BaseService <|-- PromoCodeService

BaseController <|-- AdminController
BaseController <|-- AuthController
BaseController <|-- BookingController
BaseController <|-- RoomController
BaseController <|-- ReviewController
BaseController <|-- PromoController

' --- 2. COMPOSITION (*--) ---
' (Whole-part relationship where the part cannot exist independently)
BookingRequest *-- GuestInfoDto : "contains guestInfo"

' --- 3. AGGREGATION (o--) ---
' (Services aggregate their repositories and dependent services)
RoomService o-- RoomRepository : "roomRepository"
RoomService o-- BookingRepository : "bookingRepository"

BookingService o-- BookingRepository : "bookingRepository"
BookingService o-- RoomService : "roomService"

UserService o-- UserRepository : "userRepository"

ReviewService o-- ReviewRepository : "reviewRepository"

PromoCodeService o-- PromoCodeRepository : "promoCodeRepository"

' (Controllers aggregate their services)
AdminController o-- UserService : "userService"
AdminController o-- RoomService : "roomService"
AdminController o-- BookingService : "bookingService"
AdminController o-- ReviewService : "reviewService"

AuthController o-- UserService : "userService"

BookingController o-- BookingService : "bookingService"

RoomController o-- RoomService : "roomService"

ReviewController o-- ReviewService : "reviewService"

PromoController o-- PromoCodeService : "promoCodeService"

' (DataInitializer aggregates all repositories for seeding)
DataInitializer o-- RoomRepository : "roomRepository"
DataInitializer o-- UserRepository : "userRepository"
DataInitializer o-- ReviewRepository : "reviewRepository"
DataInitializer o-- PromoCodeRepository : "promoCodeRepository"
DataInitializer o-- BookingRepository : "bookingRepository"

' --- 4. ASSOCIATION (-->) ---
' (Domain relationships between Entities)
Booking "0..*" --> "1" Room : "room"
Booking "0..*" ..> "0..1" User : "userId"

' --- 5. DEPENDENCY (..>) ---
' (Repository to Entity)
BookingRepository ..> Booking : "<<manages>>"
RoomRepository ..> Room : "<<manages>>"
UserRepository ..> User : "<<manages>>"
ReviewRepository ..> Review : "<<manages>>"
PromoCodeRepository ..> PromoCode : "<<manages>>"

' (Controllers depending on DTOs)
AuthController ..> AuthRequest : "<<uses>>"
AuthController ..> RegisterRequest : "<<uses>>"
AuthController ..> UpdateProfileRequest : "<<uses>>"

BookingController ..> BookingRequest : "<<uses>>"
BookingController ..> CancelBookingRequest : "<<uses>>"
BookingController ..> RateBookingRequest : "<<uses>>"

PromoController ..> PromoValidateRequest : "<<uses>>"

ReviewController ..> ReviewRequest : "<<uses>>"

' (Services depending on DTOs)
BookingService ..> BookingRequest : "<<processes>>"
BookingService ..> GuestInfoDto : "<<extracts>>"
UserService ..> RegisterRequest : "<<processes>>"
UserService ..> UpdateProfileRequest : "<<processes>>"
ReviewService ..> ReviewRequest : "<<processes>>"

' (Main application launch triggers)
HotelReservationApplication ..> DataInitializer : "<<initializes>>"
HotelReservationApplication ..> AppReadyListener : "<<registers>>"

@enduml
